{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies", "housekeeping"],
  "schedule": ["before 4am"],
  "automerge": false,
  "vulnerabilityAlerts": { "labels": ["security", "dependencies"] },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "customManagers": [
    {
      "description": "versions.yaml single source of truth (D42) — bump the annotated `current` pins",
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+\\S+:\\s*\"(?<currentValue>[^\"]+)\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group non-major dev-time updates to keep noise down",
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev-dependencies (non-major)"
    },
    {
      "description": "OpenSearch moves as one PR: versions.yaml plus every consumer check-versions.sh checks, including the CI service images the github-actions group would otherwise take",
      "matchPackageNames": ["opensearchproject/opensearch"],
      "groupName": "opensearch"
    },
    {
      "description": "Grype is bumped in versions.yaml only: the Dockerfile writes it v-prefixed in FROM, so after the bump run check-versions.sh --fix on the PR",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["anchore/grype"],
      "enabled": false
    },
    {
      "description": "Stay on Python 3.12 (requires-python, the scanner images, .python-version) until a deliberate upgrade",
      "matchPackageNames": ["python"],
      "allowedVersions": "<3.13"
    }
  ]
}
