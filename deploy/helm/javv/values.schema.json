{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "javv values",
  "description": "A mistyped key fails the install instead of being ignored. Settings are checked by name in backend/tests/test_compose_settings.py, not here.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "startupProbe": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podLabels": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "extraEnv": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podLabels": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "secretKey": {
          "type": "string"
        },
        "bootstrapAdminPassword": {
          "type": "string"
        }
      }
    },
    "opensearch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passwordSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "caSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    }
  }
}
