{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "javv-opensearch values",
  "description": "Checks JAVV's own keys. The official chart's keys under opensearch pass through unchecked, as that chart has no schema.",
  "type": "object",
  "required": ["opensearch"],
  "properties": {
    "opensearch": {
      "type": "object",
      "required": ["javv"],
      "properties": {
        "singleNode": { "type": "boolean" },
        "javv": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auth", "tls"],
          "properties": {
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": { "type": "string" },
                "password": { "type": "string" }
              }
            },
            "tls": {
              "type": "object",
              "additionalProperties": false,
              "required": ["certManager"],
              "properties": {
                "existingSecret": { "type": "string" },
                "certManager": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "issuerRef": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": { "type": "string" },
                        "kind": { "enum": ["Issuer", "ClusterIssuer"] },
                        "group": { "type": "string" }
                      }
                    }
                  }
                },
                "adminDn": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
